From 62ef4f57d52ab778417f6985a9242002af538a5e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Dav=C3=AD=C3=B0=20Steinn=20Geirsson?= <david@dsg.is>
Date: Wed, 27 Aug 2025 20:11:24 +0000
Subject: [PATCH] Xen: do suspend_late and suspend_noirq phases when
 suspending.

---
 drivers/xen/manage.c | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/drivers/xen/manage.c b/drivers/xen/manage.c
index 0bcac09d5dc5..0cc7525a1f64 100644
--- a/drivers/xen/manage.c
+++ b/drivers/xen/manage.c
@@ -125,6 +125,20 @@ static void do_suspend(void)
 		goto out_thaw;
 	}
 
+	if (xen_use_suspend) {
+		err = dpm_suspend_late(PMSG_SUSPEND);
+		if (err) {
+			pr_err("late suspend of devices failed\n");
+			goto out_thaw;
+		}
+
+		err = dpm_suspend_noirq(PMSG_SUSPEND);
+		if (err) {
+			pr_err("noirq suspend of devices failed\n");
+			goto out_thaw;
+		}
+	}
+
 	printk(KERN_DEBUG "suspending xenstore...\n");
 	xs_suspend();
 
@@ -149,6 +163,11 @@ static void do_suspend(void)
 
 	xen_arch_resume();
 
+	if (xen_use_suspend) {
+		dpm_resume_noirq(PMSG_RESUME);
+		dpm_resume_early(PMSG_RESUME);
+	}
+
 	dpm_resume_start(xen_use_suspend ? PMSG_RESUME : (si.cancelled ? PMSG_THAW : PMSG_RESTORE));
 
 	if (err) {
-- 
2.47.2

